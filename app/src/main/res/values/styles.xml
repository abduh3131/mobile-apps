<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Todo.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="backgroundTint">@color/primaryPurple</item>
        <item name="rippleColor">@color/primaryPurpleDark</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.Todo.SecondaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/backButtonTint</item>
        <item name="rippleColor">@color/primaryPurpleDark</item>
        <item name="cornerRadius">100dp</item>
    </style>

    <style name="Widget.Todo.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:padding">24dp</item>
        <item name="cardBackgroundColor">@color/surfaceContainer</item>
        <item name="strokeColor">@color/surfaceVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>
</resources>
