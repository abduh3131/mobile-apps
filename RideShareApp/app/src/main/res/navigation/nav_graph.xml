<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.rideshare.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_auth"
            app:destination="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/authFragment"
        android:name="com.example.rideshare.ui.auth.AuthFragment"
        android:label="Authentication"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_auth_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.rideshare.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_request"
            app:destination="@id/rideRequestFragment" />
        <action
            android:id="@+id/action_dashboard_to_support"
            app:destination="@id/supportFragment" />
        <action
            android:id="@+id/action_dashboard_to_profile"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/rideRequestFragment"
        android:name="com.example.rideshare.ui.ride.RideRequestFragment"
        android:label="Ride Request"
        tools:layout="@layout/fragment_ride_request">
        <action
            android:id="@+id/action_request_to_tracking"
            app:destination="@id/trackingFragment" />
    </fragment>

    <fragment
        android:id="@+id/trackingFragment"
        android:name="com.example.rideshare.ui.ride.TrackingFragment"
        android:label="Live Tracking"
        tools:layout="@layout/fragment_tracking">
        <action
            android:id="@+id/action_tracking_to_summary"
            app:destination="@id/tripSummaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripSummaryFragment"
        android:name="com.example.rideshare.ui.ride.TripSummaryFragment"
        android:label="Trip Summary"
        tools:layout="@layout/fragment_trip_summary" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.rideshare.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/supportFragment"
        android:name="com.example.rideshare.ui.support.SupportFragment"
        android:label="Support"
        tools:layout="@layout/fragment_support" />

</navigation>
